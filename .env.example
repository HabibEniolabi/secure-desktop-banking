# Copy to .env, fill with your own credentials, and load into the shell before running.
# MongoDB Atlas replica-set deployment with TLS (Atlas uses supported clusters by default).
MONGODB_URI="mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE=banking_simulation

# Seed first admin (run only once, then unset ADMIN_PASSWORD)
ADMIN_NAME="Project Admin"
ADMIN_EMAIL="admin@example.test"
ADMIN_PASSWORD="replace-with-a-unique-long-password"

# Optional: for later email-service PR. NEVER commit actual values.
SMTP_USERNAME=""
SMTP_APP_PASSWORD=""
